# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
.next/
.next-probe/
out/
build/
dist/

# Production
*.tsbuildinfo
next-env.d.ts

# Environment — never commit real secrets. Commit .env.example instead.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Prisma
prisma/*.db
prisma/*.db-journal

# Deployment
.vercel/

# Editors
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test / coverage output
coverage/
playwright-report/
test-results/

# Agent-local settings (machine-specific). The shared launch.json IS tracked.
.claude/settings.local.json
.vercel
# `vercel link` writes .env.local; covered by the Environment rules above.
!.env.example
